{
  "version": 2,
  "outputDirectory": "roberto-multi-tanent-mobile-dashboard/build/web",
  "cleanUrls": true,
  "rewrites": [
    {
      "source": "/((?!api/|static/|favicon.ico|manifest.json|flutter_bootstrap.js|flutter_service_worker.js|version.json|assets/|canvaskit/|icons/).*)",
